{
  "compilerOptions": {
    "strict": true,
    // type-check only, scripts/build.mjs produces the Apps Script file
    "noEmit": true,
    // only types that can be blanked out, so the build can strip them without compiling
    "erasableSyntaxOnly": true,

    // Apps Script runs modern JavaScript (V8) with no browser:
    // leaving out "DOM" removes the browser globals, including the deprecated MimeType
    "target": "ES2022",
    "lib": ["ES2022"],
    "types": ["google-apps-script"]
  },
  "include": ["src/**/*.ts"]
}
